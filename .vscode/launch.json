            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "env": {"PYDEVD_WARN_SLOW_RESOLVE_TIMEOUT": "3"},
            // "args": [
            //     "hydra.run.dir=out/${now:%Y-%m-%d}/${now:%H-%M-%S}"
            // ]
        },
        {
            "name": "train_regression",
            "type": "python",
            "request": "launch",
            "program": "src/regression/train.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {"PYDEVD_WARN_SLOW_RESOLVE_TIMEOUT": "3"}
        },
        {
            "name": "make_cmip5",
            "type": "python",
            "request": "launch",
            "program": "src/data_assemble/prepare_cmip5.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {"PYDEVD_WARN_SLOW_RESOLVE_TIMEOUT": "3"}
        },
        {
            // --- НАША НОВАЯ КОНФИГУРАЦИЯ ДЛЯ ДЕБАГА ---
            "name": "Debug train_regression (with args)",
            "type": "python",
            "request": "launch",
            "program": "src/regression/train.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {"PYDEVD_WARN_SLOW_RESOLVE_TIMEOUT": "3"},
            "args": [ // <-- ВОТ ДОБАВЛЕННЫЙ БЛОК
